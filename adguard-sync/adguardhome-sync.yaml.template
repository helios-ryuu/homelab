cron: "*/5 * * * *"
runOnStart: true

api:
  port: 0

origin:
  url: "${SYNC_ORIGIN_URL}"
  username: "${ADGUARD_ADMIN_USER}"
  password: "${ADGUARD_ADMIN_PASSWORD}"

replicas:
  - url: "${SYNC_REPLICA_URL}"
    username: "${ADGUARD_ADMIN_USER}"
    password: "${ADGUARD_ADMIN_PASSWORD}"
    auto_setup: true

features:
  general_settings: true
  query_log_config: true
  stats_config: true
  client_settings: true              # Đồng bộ danh sách clients bypass
  services: true
  filters: true
  custom_rules: true
  dns:
    access_lists: true
    server_config: false             # KHÔNG sync server_config để giữ nguyên bind_hosts và port riêng của từng node
    upstreams: true                  # Đồng bộ upstream Unbound 127.0.0.1:5335
    rewrites: true
