# ========================================================
# CẤU HÌNH NODE VÀ BẢO MẬT HOMELAB DNS (GITOPS)
# Sao chép file này thành .env trên từng node (hoặc máy quản trị)
# File .env được .gitignore bảo vệ, không bao giờ commit lên Git.
# ========================================================

# 1. Định danh Node & Network
# Nếu để trống, deploy.sh sẽ tự động nhận diện IP LAN và Tailscale qua interface
NODE_ROLE=origin           # 'origin' (Node chính/Master) hoặc 'replica' (Node phụ)
NODE_LAN_IP=               # Ví dụ: 192.168.1.10
NODE_TS_IP=                # Ví dụ: 100.64.0.1

# 2. Tailscale MagicDNS Forwarder (Tùy chọn)
TAILSCALE_DOMAIN=          # Ví dụ: taileec39c.ts.net (để trống nếu không dùng)
TAILSCALE_DNS_IP=100.100.100.100

# 3. Thông tin xác thực AdGuard Home
ADGUARD_ADMIN_USER=admin
ADGUARD_PASSWORD_HASH=     # Bcrypt hash của mật khẩu admin (tùy chọn)
ADGUARD_ADMIN_PASSWORD=    # Mật khẩu plain-text của admin để Sync Engine gọi API

# 4. Cấu hình Sync Engine (Chỉ cần thiết lập trên node Origin)
SYNC_ORIGIN_URL=           # Ví dụ: http://100.64.0.1:8080
SYNC_REPLICA_URL=          # Ví dụ: http://100.64.0.2:8080

# 5. Remote Orchestration (Dùng cho script deploy-remote.sh)
REMOTE_USER=               # Tên user SSH (mặc định lấy theo $USER hiện tại)
PRIMARY_HOST=              # IP hoặc hostname của node chính (Origin)
SECONDARY_HOST=            # IP hoặc hostname của node phụ (Replica)
